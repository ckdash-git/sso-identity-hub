# ============================================================
# SSO Identity Hub — Production Environment
# Domain: cachatto.click
#
# BEFORE USE: Replace every FILL_IN_* value.
# Run scripts/generate-secrets.sh first to get POSTGRES_PASSWORD
# and SCIM_BEARER_TOKEN.
# ============================================================

# --- Server ---
SERVER_PORT=8080
SERVER_ENV=production
SERVER_READ_TIMEOUT_SECONDS=30
SERVER_WRITE_TIMEOUT_SECONDS=30
SERVER_IDLE_TIMEOUT_SECONDS=120

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sso_user
POSTGRES_PASSWORD=FILL_IN_FROM_GENERATE_SECRETS
POSTGRES_DB=sso_identity_hub
POSTGRES_SSLMODE=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_CONN_MAX_LIFETIME_MINUTES=5

# --- Casdoor ---
CASDOOR_ENDPOINT=https://auth.cachatto.click
CASDOOR_CLIENT_ID=FILL_IN_FROM_CASDOOR_ADMIN
CASDOOR_CLIENT_SECRET=FILL_IN_FROM_CASDOOR_ADMIN
CASDOOR_ORGANIZATION_NAME=built-in
CASDOOR_APPLICATION_NAME=sso-identity-hub
CASDOOR_CERTIFICATE=FILL_IN_CASDOOR_CERT_PEM

# --- OIDC ---
OIDC_ISSUER_URL=https://auth.cachatto.click
OIDC_REDIRECT_URI=https://hub.cachatto.click/auth/callback
OIDC_SCOPES=openid,profile,email,phone

# --- JWT / Token Policy ---
JWT_RS256_PRIVATE_KEY_PATH=/secrets/rsa_private.pem
JWT_RS256_PUBLIC_KEY_PATH=/secrets/rsa_public.pem
JWT_KEY_ID=sso-hub-key-2026-v1
TOKEN_MAX_AGE_SECONDS=28800
TOKEN_REFRESH_MAX_AGE_SECONDS=28800

# --- Back-Channel Logout ---
BACKCHANNEL_LOGOUT_ENDPOINTS=
BACKCHANNEL_LOGOUT_TIMEOUT_SECONDS=5
BACKCHANNEL_LOGOUT_MAX_RETRIES=3

# --- Microsoft Graph API ---
MSGRAPH_TENANT_ID=FILL_IN_AZURE_TENANT_ID
MSGRAPH_CLIENT_ID=FILL_IN_AZURE_CLIENT_ID
MSGRAPH_CLIENT_SECRET=FILL_IN_AZURE_CLIENT_SECRET
MSGRAPH_SCOPE=https://graph.microsoft.com/.default

# --- SCIM 2.0 ---
SCIM_BEARER_TOKEN=FILL_IN_FROM_GENERATE_SECRETS
SCIM_EXTERNAL_ENDPOINT=

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json
