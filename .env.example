# ============================================================
# SSO Identity Hub — Environment Configuration Template
# Copy this file to .env and fill in actual values.
# ============================================================

# --- Server ---
SERVER_PORT=8080
SERVER_ENV=development                  # development | staging | production
SERVER_READ_TIMEOUT_SECONDS=30
SERVER_WRITE_TIMEOUT_SECONDS=30
SERVER_IDLE_TIMEOUT_SECONDS=120

# --- PostgreSQL (primary identity store) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sso_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=sso_identity_hub
POSTGRES_SSLMODE=require               # disable | require | verify-full
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_CONN_MAX_LIFETIME_MINUTES=5

# --- Casdoor (Primary IdP) ---
CASDOOR_ENDPOINT=https://your-casdoor-instance.example.com
CASDOOR_CLIENT_ID=your_casdoor_client_id
CASDOOR_CLIENT_SECRET=CHANGE_ME_CASDOOR_SECRET
CASDOOR_ORGANIZATION_NAME=built-in
CASDOOR_APPLICATION_NAME=sso-identity-hub
CASDOOR_CERTIFICATE=your_casdoor_public_cert_pem   # PEM or path to PEM file

# --- OIDC ---
OIDC_ISSUER_URL=https://your-casdoor-instance.example.com
OIDC_REDIRECT_URI=https://your-app.example.com/auth/callback
OIDC_SCOPES=openid,profile,email,phone

# --- JWT / Token Policy ---
# Path to RSA private key PEM file used for signing logout tokens
JWT_RS256_PRIVATE_KEY_PATH=/secrets/rsa_private.pem
JWT_RS256_PUBLIC_KEY_PATH=/secrets/rsa_public.pem
JWT_KEY_ID=sso-hub-key-2024
# Maximum session lifetime before forced re-authentication (seconds)
TOKEN_MAX_AGE_SECONDS=28800            # 8 hours
TOKEN_REFRESH_MAX_AGE_SECONDS=28800    # 8 hours — matches sign-in frequency policy

# --- Back-Channel Logout ---
# Comma-separated list of third-party logout endpoints to notify on session termination
BACKCHANNEL_LOGOUT_ENDPOINTS=https://app-a.example.com/backchannel-logout,https://app-b.example.com/backchannel-logout
BACKCHANNEL_LOGOUT_TIMEOUT_SECONDS=5
BACKCHANNEL_LOGOUT_MAX_RETRIES=3

# --- Microsoft Graph API (for Azure AD / Entra ID token revocation) ---
MSGRAPH_TENANT_ID=your_azure_tenant_id
MSGRAPH_CLIENT_ID=your_azure_app_client_id
MSGRAPH_CLIENT_SECRET=CHANGE_ME_AZURE_SECRET
MSGRAPH_SCOPE=https://graph.microsoft.com/.default

# --- SCIM 2.0 Provisioning ---
SCIM_BEARER_TOKEN=CHANGE_ME_SCIM_TOKEN
SCIM_EXTERNAL_ENDPOINT=https://external-service.example.com/scim/v2

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# --- Logging ---
LOG_LEVEL=info                         # debug | info | warn | error
LOG_FORMAT=json                        # json | console
