# ============================================================
# Caddyfile — Production Reverse Proxy
#
# Caddy obtains and renews Let's Encrypt TLS certificates
# automatically.
#
# Deploy path on VPS: /opt/sso-identity-hub/Caddyfile
# ============================================================

{
    email ops@cachatto.click
}

# ---- Casdoor (IdP / OIDC / SAML endpoint) ------------------
auth.cachatto.click {
    reverse_proxy sso_casdoor:8000 {
        header_up Host {http.request.host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        health_uri  /
        health_interval 10s
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    log {
        output file /var/log/caddy/auth.cachatto.click.log {
            roll_size     100mb
            roll_keep     5
            roll_keep_for 720h
        }
        format json
    }
}

# ---- SSO Identity Hub Go server ----------------------------
hub.cachatto.click {
    reverse_proxy sso_server:8080 {
        header_up Host {http.request.host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        health_uri  /healthz
        health_interval 10s
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    log {
        output file /var/log/caddy/hub.cachatto.click.log {
            roll_size     100mb
            roll_keep     5
            roll_keep_for 720h
        }
        format json
    }
}

# ---- Redirect bare domain to auth subdomain ----------------
cachatto.click {
    redir https://auth.{host}{uri} permanent
}
